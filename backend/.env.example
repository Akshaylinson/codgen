# Copy to .env — never commit .env
# ── Required ──────────────────────────────────────────────────────────────────
MUAPI_API_KEY=your_muapi_key_here
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
DATABASE_URL=postgresql://codgen:password@localhost:5432/codgen

# ── Optional ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com
DEFAULT_CREDITS=100
JWT_EXPIRE_DAYS=7

# ── S3 / Cloudflare R2 (leave blank to skip — falls back to muapi upload) ────
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
# R2 endpoint example: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Public CDN URL for your bucket (e.g. https://cdn.yourdomain.com)
CDN_BASE_URL=
